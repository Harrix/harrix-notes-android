{
  "name": "harrix-notes-editor",
  "version": "1.0.0",
  "description": "CodeMirror 6 Markdown editor bundled for the Android WebView editor pane",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --target=chrome80 --legal-comments=none --outfile=../app/src/main/assets/editor/editor.js",
    "watch": "esbuild src/editor.js --bundle --format=iife --target=chrome80 --outfile=../app/src/main/assets/editor/editor.js --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
